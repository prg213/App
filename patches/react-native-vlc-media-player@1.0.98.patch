+    private boolean hasRetainablePlayer() {
+        return !isTerminalCleanup && libvlc != null && mMediaPlayer != null;
+    }
+
+    private boolean syncVlcOutputToView(String reason) {
+        if (!hasRetainablePlayer()) return false;
+        int outputWidth = getWidth();
+        int outputHeight = getHeight();
+        if (outputWidth <= 0 || outputHeight <= 0) return false;
+
+        IVLCVout vlcOut = mMediaPlayer.getVLCVout();
+        vlcOut.setWindowSize(outputWidth, outputHeight);
+        applyResizeMode();
+        // setWindowSize updates this attached Vout in libVLC 3.6. Calling the
+        // removed updateVideoSurfaces API is neither necessary nor compatible.
+        // This remains a presentation-only change: the player and stream stay put.
+        Log.i(tag, "surface-output-size reason=" + reason
+                + " output=" + outputWidth + "x" + outputHeight
+                + " resizeMode=" + resizeMode);
+        return true;
+    }
+
+    private void applyResizeMode() {
+        if (mMediaPlayer == null) return;
+        try {
+            if ("cover".equals(resizeMode)) {
+                mMediaPlayer.setVideoScale(MediaPlayer.ScaleType.SURFACE_FIT_SCREEN);
+            } else if ("fill".equals(resizeMode)) {
+                // Force libVLC's output aspect to the actual TextureView bounds.
+                // SURFACE_FILL is intended to occupy the complete display, but
+                // explicitly setting the presentation aspect here prevents a
+                // stale 16:9 stream aspect from being re-applied after a native
+                // layout/Vout update. setScale(0) keeps VLC's automatic pixel
+                // scaling while the aspect ratio is supplied by the viewport.
+                int outputWidth = getWidth();
+                int outputHeight = getHeight();
+                if (outputWidth > 0 && outputHeight > 0) {
+                    mMediaPlayer.setAspectRatio(outputWidth + ":" + outputHeight);
+                } else {
+                    mMediaPlayer.setAspectRatio(null);
+                }
+                mMediaPlayer.setScale(0);
+                mMediaPlayer.setVideoScale(MediaPlayer.ScaleType.SURFACE_FILL);
+            } else {
+                mMediaPlayer.setVideoScale(MediaPlayer.ScaleType.SURFACE_BEST_FIT);
+            }
+        } catch (Exception e) {
+            Log.w(tag, "resize-mode failed mode=" + resizeMode, e);
+        }
+    }
+
+    public void setResizeMode(String mode) {
+        if (mode == null || mode.length() == 0) mode = "contain";
+        if (!"contain".equals(mode) && !"cover".equals(mode) && !"fill".equals(mode)) {
+            mode = "contain";
+        }
+        resizeMode = mode;
+        if (mMediaPlayer != null) {
+            applyResizeMode();
+        }
+    }
+
+    private void detachVlcOutputForSurfaceLoss(String reason) {
+        if (!hasRetainablePlayer()) return;
+        isForegroundSurfaceRecoveryPending = true;
+        isSurfaceViewDestory = true;
+        IVLCVout vlcOut = mMediaPlayer.getVLCVout();
+        if (vlcOut.areViewsAttached()) {
+            Log.i(tag, "surface-output-detach reason=" + reason);
+            vlcOut.detachViews();
+        }
+    }
+
+    private void recoverVlcOutputIfReady(String reason) {
+        if (!isForegroundSurfaceRecoveryPending || !hasRetainablePlayer()
+                || !isViewAttachedToWindow || !isSurfaceTextureAvailable
+                || getSurfaceTexture() == null) return;
+        IVLCVout vlcOut = mMediaPlayer.getVLCVout();
+        if (vlcOut.areViewsAttached()) {
+            syncVlcOutputToView("already-attached-" + reason);
+            isSurfaceViewDestory = false;
+            isForegroundSurfaceRecoveryPending = false;
+            resumeHostPausedPlayerIfReady("already-attached-" + reason);
+            return;
+        }
+        if (!syncVlcOutputToView("reattach-" + reason)) return;
+        Log.i(tag, "surface-output-reattach reason=" + reason
+                + " output=" + getWidth() + "x" + getHeight());
+        vlcOut.setVideoSurface(getSurfaceTexture());
+        vlcOut.attachViews(onNewVideoLayoutListener);
+        isSurfaceViewDestory = false;
+        isForegroundSurfaceRecoveryPending = false;
+        resumeHostPausedPlayerIfReady("reattached-" + reason);
+    }
