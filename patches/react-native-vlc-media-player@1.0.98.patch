+    private boolean hasRetainablePlayer() {
+        return !isTerminalCleanup && libvlc != null && mMediaPlayer != null;
+    }
+
+    /**
+     * A TextureView surface is presentation state, not media-session state.
+     * Keep the active libVLC player alive while its foreground output is
+     * temporarily unavailable, then attach that same output to the replacement
+     * SurfaceTexture as soon as Android gives us one.
+     */
+    private void detachVlcOutputForSurfaceLoss(String reason) {
+        if (!hasRetainablePlayer()) {
+            trace("foreground-surface-detach-skip reason=" + reason
+                    + " retainable=false terminal=" + isTerminalCleanup);
+            return;
+        }
+
+        isForegroundSurfaceRecoveryPending = true;
+        isSurfaceViewDestory = true;
+        final IVLCVout vlcOut = mMediaPlayer.getVLCVout();
+        if (vlcOut.areViewsAttached()) {
+            trace("foreground-surface-detach-existing-player reason=" + reason
+                    + " player=" + System.identityHashCode(mMediaPlayer));
+            vlcOut.detachViews();
+        } else {
+            trace("foreground-surface-detach-already-detached reason=" + reason
+                    + " player=" + System.identityHashCode(mMediaPlayer));
+        }
+        isVoutAttached = false;
+    }
+
+    private void recoverVlcOutputIfReady(String reason) {
+        if (!isForegroundSurfaceRecoveryPending || !hasRetainablePlayer()) {
+            return;
+        }
+        if (!isViewAttachedToWindow || !isSurfaceTextureAvailable
+                || getSurfaceTexture() == null) {
+            trace("foreground-surface-rebind-wait reason=" + reason
+                    + " viewAttached=" + isViewAttachedToWindow
+                    + " surfaceAvailable=" + isSurfaceTextureAvailable);
+            return;
+        }
+
+        try {
+            final IVLCVout vlcOut = mMediaPlayer.getVLCVout();
+            if (vlcOut.areViewsAttached()) {
+                isVoutAttached = true;
+                isSurfaceViewDestory = false;
+                isForegroundSurfaceRecoveryPending = false;
+                trace("foreground-surface-rebind-already-attached reason=" + reason
+                        + " player=" + System.identityHashCode(mMediaPlayer));
+                return;
+            }
+
+            trace("foreground-surface-rebind-existing-player reason=" + reason
+                    + " player=" + System.identityHashCode(mMediaPlayer)
+                    + " playing=" + mMediaPlayer.isPlaying());
+            vlcOut.setVideoSurface(getSurfaceTexture());
+            vlcOut.attachViews(onNewVideoLayoutListener);
+            isVoutAttached = true;
+            isSurfaceViewDestory = false;
+            isForegroundSurfaceRecoveryPending = false;
+        } catch (IllegalStateException exception) {
+            trace("foreground-surface-rebind-failed reason=" + reason
+                    + " error=" + exception.getClass().getSimpleName());
+        }
+    }
+
+    private void releaseSurfaceVideo() {
+        if (surfaceVideo != null) {
+            surfaceVideo.release();
+            surfaceVideo = null;
+        }
+    }
