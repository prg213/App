+    private int[] resolveOutputWindowSize() {
+        View root = getRootView();
+        int rootWidth = root == null ? 0 : root.getWidth();
+        int rootHeight = root == null ? 0 : root.getHeight();
+        int outputWidth = rootWidth > 0 ? rootWidth : (screenWidth > 0 ? screenWidth : mVideoWidth);
+        int outputHeight = rootHeight > 0 ? rootHeight : (screenHeight > 0 ? screenHeight : mVideoHeight);
+        Log.i(tag, "output-window root=" + rootWidth + "x" + rootHeight
+                + " display=" + screenWidth + "x" + screenHeight
+                + " output=" + outputWidth + "x" + outputHeight);
+        return new int[] { outputWidth, outputHeight };
+    }
+
+    private void detachVlcOutputForSurfaceLoss(String reason) {
+        if (!hasRetainablePlayer()) return;
+        isForegroundSurfaceRecoveryPending = true;
+        isSurfaceViewDestory = true;
+        IVLCVout vlcOut = mMediaPlayer.getVLCVout();
+        if (vlcOut.areViewsAttached()) {
+            Log.i(tag, "surface-output-detach reason=" + reason);
+            vlcOut.detachViews();
+        }
+    }
+
+    private void recoverVlcOutputIfReady(String reason) {
+        if (!isForegroundSurfaceRecoveryPending || !hasRetainablePlayer()
+                || !isViewAttachedToWindow || !isSurfaceTextureAvailable
+                || getSurfaceTexture() == null) return;
+        IVLCVout vlcOut = mMediaPlayer.getVLCVout();
+        if (vlcOut.areViewsAttached()) {
+            isSurfaceViewDestory = false;
+            isForegroundSurfaceRecoveryPending = false;
+            return;
+        }
+        int[] outputSize = resolveOutputWindowSize();
+        Log.i(tag, "surface-output-reattach reason=" + reason
+                + " output=" + outputSize[0] + "x" + outputSize[1]);
+        vlcOut.setWindowSize(outputSize[0], outputSize[1]);
+        vlcOut.setVideoSurface(getSurfaceTexture());
+        vlcOut.attachViews(onNewVideoLayoutListener);
+        isSurfaceViewDestory = false;
+        isForegroundSurfaceRecoveryPending = false;
+    }
